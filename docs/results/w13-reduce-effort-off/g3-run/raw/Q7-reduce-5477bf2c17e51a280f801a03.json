    "claims": [
      {
        "text": "Morgan Stanley recruits financial advisors through its advisor-led channel while also receiving workplace flows, and attributes strong recruitment to its platform and reputation as a place where advisors can grow their businesses.",
        "chunk_ids": [
          "MS-TR-2025Q2#33",
          "MS-TR-2025Q1#15"
        ],
        "part_id": "a1.MS"
      },
      {
        "text": "Merrill's core approach is a training program that trains people in wealth management at Bank of America and Merrill, with experienced-advisor recruiting a smaller part of its strategy.",
        "chunk_ids": [
          "BAC-TR-2025Q4#106"
        ],
        "part_id": "a1.MER"
      },
      {
        "text": "Raymond James prefers to recruit advisors one-by-one rather than through acquisitions, leads with culture and capabilities over the highest check, and offers multiple AdvisorChoice affiliation options.",
        "chunk_ids": [
          "RJF-TR-2026Q1#25",
          "RJF-TR-2026Q2#59",
          "RJF-10K-2025#10"
        ],
        "part_id": "a1.RJF"
      },
      {
        "text": "The three firms' approaches differ in emphasis: Morgan Stanley leads on its integrated platform, Merrill on an internal training program, and Raymond James on culture plus multiple affiliation options, so a like-for-like quantitative comparison cannot be made.",
        "chunk_ids": [
          "MS-TR-2025Q2#33",
          "BAC-TR-2025Q4#106",
          "RJF-TR-2026Q2#59",
          "RJF-10K-2025#10"
        ],
        "part_id": "a10"
      }
    ],
    "adjacent": [
      {
        "text": "Merrill and the Private Bank report more than 15,000 wealth advisors (approximate) rather than a Merrill-only financial advisor headcount.",
        "chunk_ids": [
          "BAC-DECK-2025-investor-day#9"
        ],
        "part_id": "a6.MER",
        "differs_because": "The firm reports 'Total wealth advisors' spanning all wealth management businesses in GWIM and Consumer Banking (a wider unit than Merrill alone); the '>15K' figure covers Merrill and Private Bank combined."
      },
      {
        "text": "Morgan Stanley reported total Wealth Management net new assets of $122.3 billion for the fourth quarter of 2025 rather than a recruiting-specific figure.",
        "chunk_ids": [
          "MS-PR-2026-01-15-01#2",
          "MS-PR-2026-01-15-01#18"
        ],
        "part_id": "a7.MS",
        "differs_because": "The firm reports total Wealth Management net new assets (client asset inflows less outflows across all channels), a wider measure that contains but does not separately break out the portion attributable to advisor recruiting."
      },
      {
        "text": "Raymond James reported domestic Private Client Group net new assets of $52,431 million for fiscal year 2025 rather than a recruiting-specific figure.",
        "chunk_ids": [
          "RJF-10K-2025#224"
        ],
        "part_id": "a7.RJF",
        "differs_because": "The firm reports total 'Domestic Private Client Group net new assets' (all client inflows less all outflows), which reflects advisor recruiting and retention together with other factors, but it does not separately quantify the portion of net new assets attributable specifically to advisor recruiting."
      }
    ],
