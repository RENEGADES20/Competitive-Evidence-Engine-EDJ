    "claims": [
      {
        "text": "Receiving financial advice in the future will increasingly combine AI augmentation with human advice, as firms across the industry embed technology while keeping the human relationship central.",
        "chunk_ids": [
          "CAPGEMINI-WWR-2026#3",
          "MCK-SIGNAL-SELLOFF-2026#2",
          "WEALTHTENDER-ADVISOR-SEARCH-2025#26"
        ],
        "part_id": "a1.all"
      },
      {
        "text": "Schwab states that more retail clients are seeking holistic advice delivered seamlessly on their terms through a combination of people and increasingly AI-enabled technology.",
        "chunk_ids": [
          "SCHW-TR-2026Q2#15"
        ],
        "part_id": "a1.all"
      },
      {
        "text": "Nearly 80 percent of affluent households still prefer a human relationship, and more than 90 percent of U.S. investors prefer human involvement alongside AI technology.",
        "chunk_ids": [
          "MCK-SIGNAL-SELLOFF-2026#8",
          "SCHW-TR-2026Q3#6"
        ],
        "part_id": "a2.all"
      },
      {
        "text": "Deloitte predicts agentic AI could lift adviser productivity by roughly 30% to 100% by 2032, freeing 25% to 50% of adviser time from lower-value operational work.",
        "chunk_ids": [
          "DELOITTE-AGENTIC-2026#0"
        ],
        "part_id": "a4.all"
      },
      {
        "text": "McKinsey projects a shortfall of 90,000 to 110,000 advisors by 2034, while Schwab is continuing to hire financial consultants and wealth advisers, with Raymond James ending fiscal 2025 at a record 8,943 financial advisors.",
        "chunk_ids": [
          "MCK-SIGNAL-SELLOFF-2026#4",
          "SCHW-TR-2026Q1#4",
          "RJF-TR-2025Q3#4"
        ],
        "part_id": "a8.all"
      }
