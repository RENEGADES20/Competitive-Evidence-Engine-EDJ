        "items": [
          {
            "text": "Merrill launched Tax Efficient Transition Service (TET) and Dollar Cost Averaging Service (DCA), new services combining automation with portfolio oversight to help clients transition assets and deploy cash within the Merrill Lynch Investment Advisory Program.",
            "quote": "Merrill today announced the launch of Tax Efficient Transition Service (TET) and Dollar Cost Averaging Service (DCA), new services that combine automation with professional portfolio oversight to help clients simplify asset transitions and cash deployment into managed or custom managed investment strategies in the Merrill Lynch Investment Advisory Program (IAP).",
            "value": "",
            "unit": "",
            "period": "",
            "scope": "",
            "definition": "",
            "chunk_ids": [
              "MER-PR-2026-09-15-01#0"
            ]
          },
          {
            "text": "Merrill offers robust solutions for ultra-high-net-worth clients, including alternative investments and sustainable and impact investing strategies.",
            "quote": "Robust solutions for ultra-high-net-worth clients, including alternative investments and sustainable and impact investing strategies",
            "value": "",
