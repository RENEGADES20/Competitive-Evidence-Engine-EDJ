            "unit": "USD",
            "period": "2026Q3",
            "scope": "Wealth Management",
            "definition": "",
            "chunk_ids": [
              "MS-TR-2026Q3#15",
              "MS-PR-2026-10-14-01#2"
            ]
          },
          {
            "text": "Morgan Stanley Wealth Management reported total client assets of $8,084 billion at June 30, 2026 and $8,433 billion at September 30, 2026.",
            "quote": "Total client assets | $ 8,433 | $ 8,084 | $ 7,054 | 4% | 20%",
            "value": "$8,433 billion",
            "unit": "USD",
            "period": "2026-09-30",
