# Copy to .env and fill in. Never commit .env.
# SEC requires a name and email on every EDGAR request.
EDGAR_IDENTITY="Your Name your.email@wustl.edu"
# LLM_PROVIDER: mock (offline, free; default) | anthropic | openai
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# Only if your key is not scoped to a workspace (error mentions anthropic-workspace-id)
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
DATABASE_URL=postgresql://cee:cee@localhost:5432/cee
# Local path of the Box Drive folder that contains raw/ and snapshots/.
# Leave empty unless you run Box Drive (tech lead). Teammates download files by hand.
CORPUS_SHARE_PATH=
# Folder for the embedding model (about 70 MB, #124). Empty = <repo>/.cache/fastembed.
# Without HuggingFace access, copy the Box models/ folder into it (docs/RUN.md).
FASTEMBED_CACHE_PATH=
# Retrieval mode (#125): fts (default; keyword search only) | hybrid (keyword + vector + local
# reranker; needs a snapshot with vectors and the reranker model, docs/RUN.md).
RETRIEVAL_MODE=fts
# Optional, hybrid only: reranker model (default Xenova/ms-marco-MiniLM-L-12-v2, about 120 MB).
RERANK_MODEL=
