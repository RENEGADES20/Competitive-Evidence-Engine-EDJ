# Copy to .env and fill in. Never commit .env.
# SEC requires a name and email on every EDGAR request.
EDGAR_IDENTITY="Your Name your.email@wustl.edu"
# LLM_PROVIDER: mock (offline, free; default) | anthropic | openai | deepseek
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# Only if your key is not scoped to a workspace (error mentions anthropic-workspace-id)
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# DeepSeek (#242): OpenAI-compatible API. Keep the /beta URL: strict tool schemas need it.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com/beta
# Thinking mode of the legacy single answer call (MAP=off) only: on = the model reasons first; off = no reasoning.
# Empty = on, the default chosen from the #242 real check (docs/results/0242-deepseek-check.md).
DEEPSEEK_THINKING=
# Effort per stage of the W11 flow (#272): off (no thinking) | low | high | max. Empty = the default set
# from the #272 test A (plans/0272-latency.md).
DEEPSEEK_EFFORT_PLAN=
DEEPSEEK_EFFORT_MAP=
DEEPSEEK_EFFORT_REDUCE=
# Reduce effort of the brief synthesis answers (prompt v8, not window / all-recency questions) (#295). Empty = off.
DEEPSEEK_EFFORT_REDUCE_BRIEF=
# Model of the map calls only (#272). Empty = DEEPSEEK_MODEL.
DEEPSEEK_MODEL_MAP=
# Streaming (#272): on (every call) | nothink (only calls with thinking off) | off. Empty = on.
DEEPSEEK_STREAM=
# Stream idle timeout (#275): a streamed call with no chunk for this many seconds is aborted and fails
# (saved with its partial output; no automatic retry; the Ask page offers "Retry", #277). Empty = 120.
DEEPSEEK_IDLE_S=
# Reduce prompt version (#275, #292): v5.2 | v5.3 | v7 | v8. Empty = the default, v8 since #292 (a brief cited
# answer; window and all-recency questions keep v5.2). Results: docs/results/w13-reduce-synthesis.md.
REDUCE_PROMPT=
# verify-cee only (#277): while this file exists and names a stage (map | reduce), the mock call of that
# stage fails, so the Retry path can be shown. Leave empty; never used with a real provider.
MOCK_FAIL_FILE=
# Question planner (ADR-020, ADR-021): on = one planner call lists every aspect the question asks
# (no cap); code pairs each aspect with its firms (sub-questions). Real providers only; the mock uses
# a fixed rule. off = the rule plan, no planner call.
PLANNER=on
# Token budget of each sub-question (firm x aspect, #245). Empty = the default picked by the #245 grid.
SUBQUESTION_TOKENS=
# Map-reduce (#246, #247): per-firm extraction calls, the evidence matrix and one reduce call write the
# answer. on (default) | off. off keeps the legacy single answer call (prompt v4.1) for comparison only.
# A .env copied before #247 says MAP=off: delete that line or set MAP=on (docs/RUN.md).
MAP=on
# Parallel extraction calls of the map step (one per firm x aspect cell, #272). Empty = 24.
MAP_CONCURRENCY=
# Input ceiling of one map call in tokens (#272); a bigger cell is split into batches. Empty = 60000.
MAP_CALL_TOKENS=
# Map prefix cache (#283, not adopted): off (empty = off: the #272 extraction request) | firm (experiments only).
# With firm: largest firm block sent as the shared beginning of the firm's extraction calls (tokens; empty =
# 150000), the leader-first gate first_chunk | done | off (empty = first_chunk) and the followers' extra wait in
# seconds after it opens (empty = 5).
MAP_PREFIX=
MAP_PREFIX_TOKENS=
MAP_PREFIX_GATE=
MAP_PREFIX_WAIT_S=
DATABASE_URL=postgresql://cee:cee@localhost:5432/cee
# Docker container name and host port of the database. Empty = cee-db and 5432.
# CEE_DB_PORT must match the port in DATABASE_URL above.
CEE_DB_CONTAINER=
CEE_DB_PORT=
# Local path of the Box Drive folder that contains raw/ and snapshots/.
# Leave empty unless you run Box Drive (tech lead). Teammates download files by hand.
CORPUS_SHARE_PATH=
# Optional vectors module (ADR-009): off by default; the core needs no extension and no model.
# on = embeddings in table chunk_embeddings (needs requirements-vectors.txt; docs/RUN.md).
CEE_VECTORS=off
# Only when CEE_VECTORS=on: folder of the embedding model (about 70 MB). Empty = <repo>/.cache/fastembed.
# Never downloaded by itself: python -m cee.retrieve.embed --fetch, or copy models/ from the shared corpus folder.
FASTEMBED_CACHE_PATH=
