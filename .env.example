# Copy to .env and fill in. Never commit .env.
# SEC requires a name and email on every EDGAR request.
EDGAR_IDENTITY="Your Name your.email@wustl.edu"
# LLM_PROVIDER: mock (offline, free; default) | anthropic | openai | deepseek
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# Only if your key is not scoped to a workspace (error mentions anthropic-workspace-id)
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# DeepSeek (#242): OpenAI-compatible API. Keep the /beta URL: strict tool schemas need it.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com/beta
# Thinking mode: on = the model reasons before answering (slower, more output tokens); off = no reasoning.
# Empty = on, the default chosen from the #242 real check (docs/results/0242-deepseek-check.md).
DEEPSEEK_THINKING=
# Question planner (ADR-020, ADR-021): on = one planner call lists every aspect the question asks
# (no cap); code pairs each aspect with its firms (sub-questions). Real providers only; the mock uses
# a fixed rule. off = the rule plan, no planner call.
PLANNER=on
# Token budget of each sub-question (firm x aspect, #245). Empty = the default picked by the #245 grid.
SUBQUESTION_TOKENS=
# Temporary (#245, removed when #247 lands): most estimated input tokens of the one answer call.
# Empty = the provider's context window minus the answer output cap and the prompt (no limit on mock).
ANSWER_INPUT_MAX_TOKENS=
# Map step (#246): per-firm extraction calls and the evidence matrix. Off until #247 shows the map's
# output; #247 flips the default. The eval turns it on with --map / --map-only.
MAP=off
# Parallel extraction calls of the map step. Empty = 6 (five firms + research).
MAP_CONCURRENCY=
DATABASE_URL=postgresql://cee:cee@localhost:5432/cee
# Docker container name and host port of the database. Empty = cee-db and 5432.
# CEE_DB_PORT must match the port in DATABASE_URL above.
CEE_DB_CONTAINER=
CEE_DB_PORT=
# Local path of the Box Drive folder that contains raw/ and snapshots/.
# Leave empty unless you run Box Drive (tech lead). Teammates download files by hand.
CORPUS_SHARE_PATH=
# Optional vectors module (ADR-009): off by default; the core needs no extension and no model.
# on = embeddings in table chunk_embeddings (needs requirements-vectors.txt; docs/RUN.md).
CEE_VECTORS=off
# Only when CEE_VECTORS=on: folder of the embedding model (about 70 MB). Empty = <repo>/.cache/fastembed.
# Never downloaded by itself: python -m cee.retrieve.embed --fetch, or copy models/ from the shared corpus folder.
FASTEMBED_CACHE_PATH=
