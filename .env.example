# Copy to .env and fill in. Never commit .env.
# SEC requires a name and email on every EDGAR request.
EDGAR_IDENTITY="Your Name your.email@wustl.edu"
# LLM_PROVIDER: mock (offline, free; default) | anthropic | openai
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# Only if your key is not scoped to a workspace (error mentions anthropic-workspace-id)
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
DATABASE_URL=postgresql://cee:cee@localhost:5432/cee
# Docker container name and host port of the database. Empty = cee-db and 5432.
# CEE_DB_PORT must match the port in DATABASE_URL above.
CEE_DB_CONTAINER=
CEE_DB_PORT=
# Local path of the Box Drive folder that contains raw/ and snapshots/.
# Leave empty unless you run Box Drive (tech lead). Teammates download files by hand.
CORPUS_SHARE_PATH=
# Optional vectors module (ADR-009): off by default; the core needs no extension and no model.
# on = embeddings in table chunk_embeddings (needs requirements-vectors.txt; docs/RUN.md).
CEE_VECTORS=off
# Only when CEE_VECTORS=on: folder of the embedding model (about 70 MB). Empty = <repo>/.cache/fastembed.
# Never downloaded by itself: python -m cee.retrieve.embed --fetch, or copy models/ from the shared corpus folder.
FASTEMBED_CACHE_PATH=
# Retrieval mode (#125, experimental branch exp/hybrid only): fts (default; keyword search) |
# hybrid (keyword + vector + local reranker; needs CEE_VECTORS=on and both models, docs/RUN.md) |
# hybrid-norerank (same candidates, ordered by fusion score; no reranker; #126).
RETRIEVAL_MODE=fts
# Optional, hybrid only: reranker model (default Xenova/ms-marco-MiniLM-L-12-v2, about 120 MB;
# never downloaded by itself: python -m cee.retrieve.hybrid --fetch).
RERANK_MODEL=
